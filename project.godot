; Engine configuration file.
; Godot 4.7 — DREAD (working title)

config_version=5

[application]

config/name="Dread"
config/description="Isometric twin-stick sci-fi action RPG — corrupted alien hunter."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
InputConfig="*res://src/autoload/input_config.gd"
Assets="*res://src/autoload/assets.gd"
Sfx="*res://src/autoload/sfx.gd"
Vfx="*res://src/autoload/vfx.gd"
Feel="*res://src/autoload/feel.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="pickups"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.026, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
textures/default_filters/anisotropic_filtering_level=3
